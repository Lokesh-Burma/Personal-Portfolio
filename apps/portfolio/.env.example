# Common AWS application configuration: configure privately only at reviewed release.
BLOG_TABLE_NAME=existing-blog-table
ADMIN_EMAIL=owner@example.test
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SITE_ORIGIN=https://lokeshburma.com
COGNITO_USER_POOL_ID=ap-southeast-2_existingpool
COGNITO_CLIENT_ID=existing-public-client-id
COGNITO_LOGIN_DOMAIN=https://existing-domain.auth.ap-southeast-2.amazoncognito.com
TECHCANVAS_TABLE_NAME=existing-jobs-quota-outbox-table
TECHCANVAS_ASSETS_BUCKET=existing-private-generated-assets-bucket
TECHCANVAS_OWNER_SUBJECT=existing-cognito-owner-sub
AWS_REGION=ap-southeast-2
# Cloud writes and model use require separate reviewed activation.
TECHCANVAS_JOB_CREATION_APPROVED=false
BEDROCK_USAGE_APPROVED=false
TECHCANVAS_IMAGE_CREATION_APPROVED=false
# For local demos use pnpm dev; it creates private .env.unified.local automatically.
